<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Radegast.Gtk</AssemblyName>
    <AssemblyTitle>Pawprint Viewer</AssemblyTitle>
    <Product>Pawprint Viewer</Product>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Radegast.Gtk.Tests" />
    <PackageReference Include="GtkSharp" Version="3.24.24.95" />
    <ProjectReference Include="..\Radegast.Core\Radegast.Core.csproj" SetTargetFramework="TargetFramework=net10.0" />
    <Content Include="..\Radegast\grids.xml" Link="grids.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
